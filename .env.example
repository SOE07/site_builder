# Vorlage für Umgebungsvariablen. Echte Werte NIE committen: kopiere nach .env bzw. trage sie
# in Netlify/Vercel unter "Environment variables" ein. Gilt pro Seite (seiten/<name>/.env).

# Deploy-Ziel für den Keystatic-Adapter beim Build: netlify oder vercel
# (leer = rein statischer Build ohne Keystatic-Oberfläche)
DEPLOY_TARGET=

# Keystatic im GitHub-Modus (nur Produktion). Eigene GitHub-App pro Seite anlegen:
# https://keystatic.com/docs/github-mode
KEYSTATIC_STORAGE=local
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
