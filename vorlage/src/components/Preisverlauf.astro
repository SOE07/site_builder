---
import { preisInfo, type Produkt } from '../lib/inhalt';
import { datumDe } from '../lib/text';
interface Props { produkt: Produkt; }
const pi = preisInfo(Astro.props.produkt);
const fmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 }) + ' €';
let pfad = '';
if (pi && pi.verlauf.length > 1) {
  const t0 = Date.parse(pi.verlauf[0].datum), t1 = Date.parse(pi.aktuell.datum) || t0 + 1;
  const lo = pi.min.preis, hi = pi.max.preis || lo + 1;
  pfad = pi.verlauf.map((v, i) => `${i ? 'L' : 'M'}${(4 + ((Date.parse(v.datum) - t0) / (t1 - t0 || 1)) * 152).toFixed(1)} ${(26 - ((v.preis - lo) / (hi - lo || 1)) * 22).toFixed(1)}`).join(' ');
}
---
{pi && (
  <div class="preisverlauf">
    <h4>Preisverlauf</h4>
    <p>
      Zuletzt erfasst: <strong>{fmt(pi.aktuell.preis)}</strong> bei {pi.aktuell.haendler} (Stand {datumDe(pi.aktuell.datum)}).
      {pi.verlauf.length > 1 && <> Niedrigster erfasster Preis: {fmt(pi.min.preis)} ({datumDe(pi.min.datum)}), höchster: {fmt(pi.max.preis)} ({datumDe(pi.max.datum)}), {pi.verlauf.length} Abrufe.</>}
      {pi.verlauf.length > 1 && pi.aktuell.preis <= pi.min.preis && <> Das ist der niedrigste bisher erfasste Preis.</>}
    </p>
    {pfad && <svg class="sparkline" viewBox="0 0 160 30" role="img" aria-label="Preisverlauf als Linie"><path d={pfad} /></svg>}
    <p class="klein">Eigene Abrufe der genannten Händlerseiten, keine Preisgarantie. Maßgeblich ist der Preis beim Händler.</p>
  </div>
)}
