---
// Einziger Weg für Affiliate-Links: /go/<slug>, rel="sponsored nofollow noopener", Kennzeichnung direkt am Link.
// platz: Platzierung für die Sub-ID-Auswertung (tabelle, finder, artikel, agent). Ohne platz: /go/<slug>
interface Props { slug: string; label?: string; klasse?: string; platz?: 'tabelle' | 'finder' | 'artikel' | 'agent'; }
const { slug, label = 'Preis prüfen', klasse = 'btn btn-primary', platz } = Astro.props;
---
<a class={`${klasse} affiliate`} href={platz ? `/go/${slug}/${platz}` : `/go/${slug}`} target="_blank" rel="sponsored nofollow noopener">{label}<span class="werbe-marker">*<small> Werbelink</small></span></a>
