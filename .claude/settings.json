{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm run *)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./seiten/**/.env)",
      "Read(./seiten/**/.env.local)",
      "Read(./seiten/**/.env.production)",
      "Edit(./.env)",
      "Edit(./seiten/**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-inhalt.mjs\"",
            "timeout": 30,
            "statusMessage": "Prüfe verbotene Phrasen und Affiliate-Links …"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-commit.mjs\"",
            "timeout": 600,
            "statusMessage": "Build und Link-Check der geänderten Seiten …"
          }
        ]
      }
    ]
  }
}
